# Copy to .env.local for development. Never commit real values.

# Public origin of the site (no trailing slash). Used for canonical URLs, the sitemap,
# RSS, share links and social-preview images. Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Article database (libSQL / SQLite).
# - Local development and self-hosting: a file on persistent disk (the default).
# - Serverless hosting such as Vercel: a hosted libSQL database, e.g. Turso:
#     DATABASE_URL=libsql://<database>-<org>.turso.io
#     DATABASE_AUTH_TOKEN=<token>
DATABASE_URL=file:./data/portfolio.db
DATABASE_AUTH_TOKEN=

# Admin session cookies are Secure and __Host- prefixed in production builds. Set to
# "false" only to try a production build over plain HTTP on a private network.
# COOKIE_SECURE=false

# Read only by `npm run admin:create` for non-interactive setup (CI or a hosting shell).
# The running site never needs them. Leave unset to be prompted instead.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Muhammad Adnan
