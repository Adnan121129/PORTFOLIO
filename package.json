{
  "name": "muhammad-adnan-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run db:migrate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/db-seed.ts",
    "db:remove-samples": "tsx --conditions=react-server scripts/db-remove-samples.ts",
    "admin:create": "tsx --conditions=react-server scripts/admin-create.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "check": "npm run lint && npm run typecheck && npm run test",
    "e2e:prepare": "tsx --conditions=react-server scripts/e2e-prepare.ts",
    "e2e:serve": "npm run e2e:prepare && next build && next start -p 3100"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "github-slugger": "2.0.0",
    "hast-util-to-string": "3.0.1",
    "lucide-react": "1.52.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "shiki": "4.4.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@next/env": "16.4.2",
    "@playwright/test": "1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "geist": "1.7.2",
    "jsdom": "30.1.1",
    "playwright-core": "1.56.1",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "tsx": "4.23.14",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "description": "Personal portfolio of Muhammad Adnan \u2014 MIS, Business Intelligence and full-stack engineering.",
  "engines": {
    "node": ">=20.9.0"
  }
}
